<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- The program window: view, view models and its look.
         A library of its own, so that the tests reach the view models without building the
         program itself: its output folder is where the running poe2pricer.exe lies. -->
    <UseWPF>true</UseWPF>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Poe2Pricer.Core/Poe2Pricer.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>
</Project>
